/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include <stdio.h>
#include <string.h>

/* Private variables ---------------------------------------------------------*/
ADC_HandleTypeDef hadc1;
UART_HandleTypeDef huart2;

// --- 全域變數，供 SWV 示波器抓取波形 ---
uint32_t val_ch1 = 0;
uint32_t val_ch2 = 0;

// --- 濾波器係數 (針對 Fs=500Hz, F0=60Hz 設計) ---
// 這裡使用的是二階 IIR 陷波濾波器係數
float b0 = 0.9258, b1 = -1.3653, b2 = 0.9258;
float a1 = -1.3653, a2 = 0.8516;

// 濾波器狀態暫存 (Delay line)，保留上一次運算的狀態以確保訊號連續性
float w1_ch1 = 0, w2_ch1 = 0;
float w1_ch2 = 0, w2_ch2 = 0;

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_ADC1_Init(void);

/* USER CODE BEGIN PFP */
int _write(int file, char *ptr, int len);
uint32_t Read_ADC_Channel(ADC_HandleTypeDef* hadc, uint32_t channel);

// --- 濾波函式實作 ---
float Apply_Notch_Filter(float input, float *w1, float *w2) {
    // 使用 Direct Form II 結構實作 IIR 濾波器
    float w0 = input - a1 * (*w1) - a2 * (*w2);
    float output = b0 * w0 + b1 * (*w1) + b2 * (*w2);

    // 更新狀態 (Delay)
    *w2 = *w1;
    *w1 = w0;

    return output;
}
/* USER CODE END PFP */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_ADC1_Init();

  /* USER CODE BEGIN WHILE */
  while (1)
  {
    // --- 步驟 A: 依序讀取 IN1 與 IN2 通道 (原始數值) ---
    // 對應到您的硬體：IN1 = PA0(孔位 A0), IN2 = PA1(孔位 A1)
    uint32_t raw_ch1 = Read_ADC_Channel(&hadc1, ADC_CHANNEL_1);
    uint32_t raw_ch2 = Read_ADC_Channel(&hadc1, ADC_CHANNEL_5); // IN2 對應 CHANNEL_5

    // --- 步驟 B: 進行 60Hz 陷波濾波處理 ---
    // 將 uint32 轉為 float 交由濾波器處理
    float filtered_ch1 = Apply_Notch_Filter((float)raw_ch1, &w1_ch1, &w2_ch1);
    float filtered_ch2 = Apply_Notch_Filter((float)raw_ch2, &w1_ch2, &w2_ch2);

    // 限制範圍避免溢位 (ADC 解析度為 12-bit，範圍應在 0 ~ 4095)
    if(filtered_ch1 < 0) filtered_ch1 = 0;
    if(filtered_ch1 > 4095) filtered_ch1 = 4095;

    if(filtered_ch2 < 0) filtered_ch2 = 0;
    if(filtered_ch2 > 4095) filtered_ch2 = 4095;

    // 將濾波後的 float 數值轉回 uint32_t，供後續傳送
    val_ch1 = (uint32_t)filtered_ch1;
    val_ch2 = (uint32_t)filtered_ch2;

    // --- 步驟 C: 打包成文字格式 (數值1,數值2) 並傳送 ---
    char msg[64];
    sprintf(msg, "%lu,%lu\r\n", (unsigned long)val_ch1, (unsigned long)val_ch2);

    // 同步印到 Console (這會呼叫我們寫的 _write，透過 UART2 傳送給電腦)
    printf("%s", msg);

    // --- 步驟 D: 取樣率控制 (約 500Hz) ---
    // HAL_Delay(2) 代表延遲 2 毫秒，1000ms / 2ms = 500Hz
    // 注意：濾波器係數是基於 500Hz 設計的，請保持此延遲時間以確保濾波頻率準確在 60Hz
    HAL_Delay(2);
    /* USER CODE END WHILE */
  }
}

