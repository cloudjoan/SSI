// --- 濾波函式實作 ---
float Apply_Notch_Filter(float input, float *w1, float *w2) {
    // 使用 Direct Form II 結構實作 IIR 濾波器
    float w0 = input - a1 * (*w1) - a2 * (*w2);
    float output = b0 * w0 + b1 * (*w1) + b2 * (*w2);

    // 更新狀態 (Delay)
    *w2 = *w1;
    *w1 = w0;

    return output;
}
