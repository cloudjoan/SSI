/* USER CODE BEGIN PFP */
// 宣告切換通道並讀取 ADC 的輔助函數
uint32_t Read_ADC_Channel(ADC_HandleTypeDef* hadc, uint32_t channel);
/* USER CODE END PFP */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* Configure the system clock */
  SystemClock_Config();

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init(); // 初始化 USART2
  MX_ADC1_Init();

  /* USER CODE BEGIN 2 */
  /* USER CODE END 2 */

  /* USER CODE BEGIN WHILE */
  while (1)
  {
    // --- 步驟 A: 依序讀取 6 個通道的數值 ---
    // 因為 IN3(PA2) 和 IN4(PA3) 被 USB 通訊佔用，所以我們跳過它們，
    // 改用 IN1, IN2, IN5, IN6, IN7, IN8 來湊齊 6 個通道。

    uint32_t v1 = Read_ADC_Channel(&hadc1, ADC_CHANNEL_1); // 對應硬體 PA0
    uint32_t v2 = Read_ADC_Channel(&hadc1, ADC_CHANNEL_2); // 對應硬體 PA1
    uint32_t v3 = Read_ADC_Channel(&hadc1, ADC_CHANNEL_5); // 對應硬體 PB14
    uint32_t v4 = Read_ADC_Channel(&hadc1, ADC_CHANNEL_6); // 對應硬體 PC0
    uint32_t v5 = Read_ADC_Channel(&hadc1, ADC_CHANNEL_7); // 對應硬體 PC1
    uint32_t v6 = Read_ADC_Channel(&hadc1, ADC_CHANNEL_8); // 對應硬體 PC2

    // --- 步驟 B: 將數值打包成逗號分隔的字串 ---
    char msg[64];
    // 輸出格式: "數值1,數值2,數值3,數值4,數值5,數值6\r\n"
    sprintf(msg, "%lu,%lu,%lu,%lu,%lu,%lu\r\n",
            (unsigned long)v1, (unsigned long)v2, (unsigned long)v3,
            (unsigned long)v4, (unsigned long)v5, (unsigned long)v6);

    // 同步印到 Console 以便 Debug (保留給您看數值用)
    printf("%s", msg);

    // --- 步驟 C: 透過 USART2 (USB) 傳送 ---
    HAL_UART_Transmit(&huart2, (uint8_t*)msg, strlen(msg), 10);

    // --- 步驟 D: 取樣率控制 ---
    HAL_Delay(10);

    /* USER CODE END WHILE */
  }
  /* USER CODE BEGIN 3 */
  /* USER CODE END 3 */
}

/* USER CODE BEGIN 4 */
/**
  * @brief  手動切換 ADC 通道並讀取數值的函數
  */
uint32_t Read_ADC_Channel(ADC_HandleTypeDef* hadc, uint32_t channel)
{
  ADC_ChannelConfTypeDef sConfig = {0};

  // 覆寫通道設定
  sConfig.Channel = channel;
  sConfig.Rank = ADC_REGULAR_RANK_1;
  sConfig.SamplingTime = ADC_SAMPLETIME_2CYCLES_5; // 可增加取樣時間提高穩定度
  sConfig.SingleDiff = ADC_SINGLE_ENDED;
  sConfig.OffsetNumber = ADC_OFFSET_NONE;
  sConfig.Offset = 0;

  // 動態切換通道
  if (HAL_ADC_ConfigChannel(hadc, &sConfig) != HAL_OK)
  {
    Error_Handler();
  }

  // 啟動 ADC 並等待結果
  HAL_ADC_Start(hadc);
  HAL_ADC_PollForConversion(hadc, 10);

  return HAL_ADC_GetValue(hadc);
}

// printf 重導向 (讓 printf 能直接由 USB 輸出)
int __io_putchar(int ch)
{
  HAL_UART_Transmit(&huart2, (uint8_t *)&ch, 1, 10);
  return ch;
}
/* USER CODE END 4 */

